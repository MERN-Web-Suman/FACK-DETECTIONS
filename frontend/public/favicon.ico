<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="cyberGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="50%" stop-color="#3b82f6" />
      <stop offset="100%" stop-color="#8b5cf6" />
    </linearGradient>
    <filter id="glow">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="100" height="100" rx="20" fill="#0b1120"/>
  <path d="M50 15 L80 28 V52 C80 70 50 85 50 85 C50 85 20 70 20 52 V28 Z" fill="none" stroke="url(#cyberGrad)" stroke-width="4" filter="url(#glow)"/>
  <path d="M50 32 L68 40 V54 C68 64 50 73 50 73 C50 73 32 64 32 54 V40 Z" fill="url(#cyberGrad)" opacity="0.25"/>
  <circle cx="50" cy="50" r="10" fill="#06b6d4"/>
  <circle cx="50" cy="50" r="4" fill="#ffffff"/>
  <line x1="50" y1="20" x2="50" y2="30" stroke="#06b6d4" stroke-width="2"/>
  <line x1="50" y1="70" x2="50" y2="80" stroke="#06b6d4" stroke-width="2"/>
</svg>
